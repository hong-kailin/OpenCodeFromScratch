{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "bun",
      "request": "launch",
      "name": "调试（预设输入）",
      "program": "packages/opencode/src/index.ts",
      "cwd": "${workspaceFolder}",
      "args": [
        "run"
      ],
      "env": {
        "DEBUG_INPUTS": "[\"运行 git status 看看\"]"
      }
    },
    {
      "type": "bun",
      "request": "launch",
      "name": "调试（非交互模式）",
      "program": "packages/opencode/src/index.ts",
      "cwd": "${workspaceFolder}",
      "args": [
        "run",
        "当前目录有哪些文件？",
        "--debug"
      ]
    },
    {
      "type": "bun",
      "request": "launch",
      "name": "调试（恢复上次会话）",
      "program": "packages/opencode/src/index.ts",
      "cwd": "${workspaceFolder}",
      "args": [
        "run",
        "-c"
      ]
    },
    {
      "type": "bun",
      "request": "launch",
      "name": "调试（恢复指定会话）",
      "program": "packages/opencode/src/index.ts",
      "cwd": "${workspaceFolder}",
      "args": [
        "run",
        "-s",
        "ses_xxx"
      ]
    },
    {
      "type": "bun",
      "request": "launch",
      "name": "调试当前文件",
      "program": "${file}",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "bun",
      "request": "attach",
      "name": "Attach 到外部终端",
      "url": "ws://localhost:6499/debug",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "debugpy",
      "request": "launch",
      "name": "调试当前 Python 文件",
      "program": "${file}",
      "console": "integratedTerminal"
    }
  ]
}